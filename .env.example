DATABASE_URL="postgresql://tourist:tourist@localhost:5432/tourist_report?schema=public"
PORT=3000
# Comma-separated origins allowed to call the API (the SvelteKit dev server by default).
CORS_ORIGIN="http://localhost:5173"
# Where receipt photos are written. Relative paths resolve from the project root.
UPLOAD_DIR="uploads"
# Max receipt size in bytes (10 MB).
MAX_UPLOAD_BYTES=10485760
