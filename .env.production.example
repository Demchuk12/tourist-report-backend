# Copy to .env.production on the server and fill in. Never commit the real file.
#
#   docker compose --env-file .env.production -f compose.prod.yml up -d --build

# Hostname Caddy issues a TLS certificate for. Its A record must already point here.
APP_DOMAIN=api.example.com

# Origin(s) of the deployed PWA, comma-separated. Not the API's own domain.
CORS_ORIGIN=https://tourist-report-dev.vercel.app

# openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Database. Only the app reaches it, but use a real password anyway.
POSTGRES_USER=tourist
POSTGRES_PASSWORD=
POSTGRES_DB=tourist_report

# Per-receipt ceiling in bytes (10 MB). Keep below the Caddyfile's max_size.
MAX_UPLOAD_BYTES=10485760
